@{
    ViewBag.Title = "Contact";
}

<div class="mm-page-header">
    <div>
        <h1 class="mm-page-title">Contact &amp; Support</h1>
        <p class="mm-page-desc">
            Need help with MasterMech? Find the right support information below.
        </p>
    </div>
</div>

<div class="mm-quick-grid">

    <div class="mm-quick-card">
        <i class="fas fa-headset"></i>

        <h5>System Support</h5>

        <p>
            For issues related to MasterMech, including customer records,
            inventory, invoices, or account access, contact your system
            administrator.
        </p>
    </div>

    <div class="mm-quick-card">
        <i class="fas fa-life-ring"></i>

        <h5>Application Assistance</h5>

        <p>
            If you experience a problem while using the system, provide
            the relevant module name and a brief description of the issue
            so it can be investigated quickly.
        </p>
    </div>

    <div class="mm-quick-card">
        <i class="fas fa-user-shield"></i>

        <h5>Administrator</h5>

        <p>
            MasterMech is managed by the workshop administrator.
            For account, access, or system-related requests, contact
            your designated administrator.
        </p>
    </div>

</div>

<div class="mm-card" style="margin-top: 24px;">
    <div class="mm-card-header">
        <h3>MasterMech</h3>
    </div>

    <p>
        Workshop Management System
    </p>
</div>