@model MYMVC.Models.Item

@{
    ViewBag.Title = "Delete Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mm-page-header">
    <div>
        <h1 class="mm-page-title">Delete Item</h1>
        <p class="mm-page-desc">Are you sure you want to delete this?</p>
    </div>
</div>

<div class="mm-card" style="max-width:720px;">
    <dl class="dl-horizontal row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ItemName)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.ItemName)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ItemType)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.ItemType)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ItemCategory)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.ItemCategory)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ItemPrice)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.ItemPrice)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.QtyInHand)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.QtyInHand)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Remarks)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Remarks)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="mt-4">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a class="btn btn-outline-dark" href="@Url.Action("Index")">Back to List</a>
        </div>
    }
</div>
