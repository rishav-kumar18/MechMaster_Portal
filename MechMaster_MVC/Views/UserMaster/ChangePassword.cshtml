@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mm-page-header">
    <div>
        <h1 class="mm-page-title">Change Password</h1>
        <p class="mm-page-desc">Update your account password</p>
    </div>
</div>

<div class="mm-card" style="max-width:480px;">

    @if (ViewBag.Error != null)
    {
        <div class="validation-summary-errors"><p style="margin:0;">@ViewBag.Error</p></div>
    }

    @if (ViewBag.Msg != null)
    {
        <div style="background-color:#DCFCE7;border:1px solid #86EFAC;border-radius:6px;padding:12px 14px;margin-bottom:16px;">
            <p style="margin:0;color:#166534;">@ViewBag.Msg</p>
        </div>
    }

    <form method="post">
        <div class="form-group">
            <label>Old Password</label>
            <input type="password" name="oldPwd" class="form-control" />
        </div>

        <div class="form-group">
            <label>New Password</label>
            <input type="password" name="newPwd" class="form-control" />
        </div>

        <input type="submit" value="Change Password" class="btn btn-primary mt-2" />
    </form>
</div>
