@{
    ViewBag.Title = "About";
}

<div class="mm-page-header">
    <div>
        <h1 class="mm-page-title">About MasterMech</h1>
        <p class="mm-page-desc">
            A workshop management system designed to simplify everyday
            automotive service operations.
        </p>
    </div>
</div>

<div class="mm-card" style="margin-bottom: 20px;">
    <div class="mm-card-header">
        <h3>What is MasterMech?</h3>
    </div>

    <p>
        MasterMech is a workshop management system designed to simplify
        the everyday operations of an automotive service workshop.
        It provides a centralized workspace for managing customers,
        inventory, services, and invoices.
    </p>
</div>

<div class="mm-page-header" style="margin-top: 28px;">
    <div>
        <h2 class="mm-page-title">What MasterMech Helps You Manage</h2>
        <p class="mm-page-desc">
            Everything you need to keep your workshop records organized.
        </p>
    </div>
</div>

<div class="mm-quick-grid">

    <div class="mm-quick-card">
        <i class="fas fa-users"></i>

        <h5>Customer Management</h5>

        <p>
            Maintain customer profiles, contact information, vehicle
            details, and service-related records in one place.
        </p>
    </div>

    <div class="mm-quick-card">
        <i class="fas fa-boxes"></i>

        <h5>Inventory &amp; Items</h5>

        <p>
            Manage parts, labour, and service items used during
            workshop operations.
        </p>
    </div>

    <div class="mm-quick-card">
        <i class="fas fa-file-invoice-dollar"></i>

        <h5>Invoicing</h5>

        <p>
            Create detailed service invoices with parts, labour,
            discounts, and applicable taxes.
        </p>
    </div>

    <div class="mm-quick-card">
        <i class="fas fa-folder-open"></i>

        <h5>Organized Records</h5>

        <p>
            Keep important workshop information organized and
            easily accessible through a centralized system.
        </p>
    </div>

</div>

<div class="mm-card" style="margin-top: 24px;">
    <div class="mm-card-header">
        <h3>Our Goal</h3>
    </div>

    <p>
        The goal of MasterMech is to provide a straightforward and
        reliable workspace that makes workshop administration easier,
        faster, and more organized.
    </p>
</div>